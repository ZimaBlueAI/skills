# produce-cinematic-video user configuration
# Keep this file in the per-user config directory; never commit, paste, or share it.
# Process environment variables override this file.

# Required core tools. Use absolute paths when PATH resolves a reduced or wrong build.
PCV_FFMPEG=ffmpeg
PCV_FFPROBE=ffprobe

