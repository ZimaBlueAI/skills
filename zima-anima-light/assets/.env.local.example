# Copy values into ~/.zimablueai_skills/.env.local (or set ZIMA_LIGHT_ENV_FILE).
# Never commit real keys.

ZIMA_LIGHT_YOUTH_MODE=true
ZIMA_LIGHT_REQUIRE_COST_APPROVAL=true

# Image — Seedream (ByteDance / Ark)
ZIMA_LIGHT_SEEDREAM_ENABLED=true
ZIMA_LIGHT_SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ZIMA_LIGHT_SEEDREAM_MODEL=seedream-4-5
ZIMA_LIGHT_SEEDREAM_API_KEY=

# Image — Qwen-Image / Z-Image (optional)
ZIMA_LIGHT_QWEN_IMAGE_ENABLED=false
ZIMA_LIGHT_QWEN_IMAGE_BASE_URL=
ZIMA_LIGHT_QWEN_IMAGE_MODEL=qwen-image
ZIMA_LIGHT_QWEN_IMAGE_API_KEY=

# Video — Seedance
ZIMA_LIGHT_SEEDANCE_ENABLED=true
ZIMA_LIGHT_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ZIMA_LIGHT_SEEDANCE_MODEL=seedance-1-0-pro
ZIMA_LIGHT_SEEDANCE_API_KEY=

# Music — Haimian / SkyMusic style HTTP adapters
ZIMA_LIGHT_MUSIC_ENABLED=false
ZIMA_LIGHT_MUSIC_PROVIDER=haimian
ZIMA_LIGHT_MUSIC_BASE_URL=
ZIMA_LIGHT_MUSIC_API_KEY=

# Voice — Qwen TTS / CosyVoice compatible
ZIMA_LIGHT_TTS_ENABLED=false
ZIMA_LIGHT_TTS_PROVIDER=qwen3_tts
ZIMA_LIGHT_TTS_BASE_URL=
ZIMA_LIGHT_TTS_API_KEY=
